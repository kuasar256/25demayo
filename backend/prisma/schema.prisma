// Modelo de datos — Sistema de gestión de colchones y catres
// Dev: SQLite | Prod: PostgreSQL (cambiar provider y redeploy)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums como String (SQLite no soporta enum) ----------
// Role:                    ADMIN_GENERAL | ADMIN | ENCARGADO_FABRICA | ENCARGADO_SUCURSAL | VENDEDOR
// LocationType:            BODEGA | SUCURSAL
// MovementType:            INGRESO | AJUSTE_ENTRADA | AJUSTE_SALIDA | VENTA | ANULACION_VENTA | TRANSFERENCIA_SALIDA | TRANSFERENCIA_RECEPCION
// TransferStatus:          PENDIENTE | ENVIADA | RECIBIDA | CERRADA
// TransferDestinationType: SUCURSAL | TERCERO
// SaleStatus:              ACTIVA | ANULADA

// ---------- Seguridad ----------
model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  fullName       String
  avatarUrl      String?
  role           String    // Role
  branchId       Int? // null si no pertenece a una sucursal
  branch         Branch?   @relation("UsersBranch", fields: [branchId], references: [id])
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sales             Sale[]             @relation("Seller")
  canceledSales     Sale[]             @relation("CanceledBy")
  transfersCreated  Transfer[]         @relation("CreatedBy")
  transfersReceived Transfer[]         @relation("ReceivedBy")
  movements         StockMovement[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  cashShiftsOpened  CashShift[]        @relation("OpenedBy")
  cashShiftsClosed  CashShift[]        @relation("ClosedBy")
  productionRequested ProductionOrder[]  @relation("RequestedProduction")
  productionAssigned  ProductionOrder[]  @relation("AssignedProduction")
  quotationsCreated   Quotation[]        @relation("QuotationCreatedBy")
}

// ---------- Ubicaciones ----------
model Warehouse {
  id       Int     @id @default(autoincrement())
  name     String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  stocks           Stock[]           @relation("StockWarehouse")
  movements        StockMovement[]   @relation("MovementWarehouse")
  transfersFrom    Transfer[]        @relation("SourceWarehouse")
  productionOrders ProductionOrder[]
}

model Branch {
  id       Int     @id @default(autoincrement())
  name     String
  department String?
  address  String?
  phone    String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  users             User[]            @relation("UsersBranch")
  stocks            Stock[]           @relation("StockBranch")
  movements         StockMovement[]   @relation("MovementBranch")
  transfersReceived Transfer[]        @relation("DestinationBranch")
  sales             Sale[]
  cashShifts        CashShift[]
  productionOrders  ProductionOrder[]
}

// ---------- Catálogo ----------
model Category {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)
  products Product[]
}

model Product {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  sku         String  @unique
  description String?
  imageUrl    String?
  warrantySeal String? // sello de garantía
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  size      String // plaza y media, dos plazas, etc.
  type      String? // ejemplo: dividido, cama
  color     String?
  height    String?
  price         Float // precio de venta en Bs
  costPrice     Float   @default(0) // costo de producción / adquisición en Bs
  warrantyYears Int     @default(1) // años de garantía (ej. 1, 3, 5, 10 años)
  minStock      Int     @default(0)
  maxStock      Int?
  sku           String  @unique
  isActive  Boolean @default(true)

  stocks       Stock[]
  movements    StockMovement[]
  transferItems TransferItem[]
  saleItems    SaleItem[]
  productionOrders ProductionOrder[]
  quotationItems   QuotationItem[]
}

// ---------- Inventario (producto terminado) ----------
model Stock {
  id           Int          @id @default(autoincrement())
  variantId    Int
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  locationType String       // LocationType
  locationId   Int // Warehouse.id o Branch.id

  // Relaciones opcionales para vincular a warehouse o branch
  warehouseId  Int?
  warehouse    Warehouse?   @relation("StockWarehouse", fields: [warehouseId], references: [id])
  branchId     Int?
  branch       Branch?      @relation("StockBranch", fields: [branchId], references: [id])

  quantity     Int          @default(0)

  @@unique([variantId, locationType, locationId])
}

model StockMovement {
  id            Int          @id @default(autoincrement())
  variantId     Int
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  locationType  String       // LocationType
  locationId    Int
  type          String       // MovementType
  quantity      Int // positivo = entra, negativo = sale
  reason        String?
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  referenceType String? // SALE | TRANSFER | ADJUST
  referenceId   Int?

  // Relaciones opcionales para vincular a warehouse o branch
  warehouseId   Int?
  warehouse     Warehouse?   @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  branchId      Int?
  branch        Branch?      @relation("MovementBranch", fields: [branchId], references: [id])

  createdAt     DateTime     @default(now())

  @@index([variantId, locationType, locationId])
  @@index([createdAt])
}

// ---------- Terceros / distribuidores ----------
model ThirdParty {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("PROVEEDOR") // PROVEEDOR | DISTRIBUIDOR | OTRO
  category  String?  // ESPUMAS | TELAS | RESORTES | MADERA | ACCESORIOS | LOGISTICA | OTRO
  contact   String?
  phone     String?
  email     String?
  address   String?
  nit       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  transfers Transfer[]

  @@index([type])
  @@index([category])
}

// ---------- Transferencias ----------
model Transfer {
  id                 Int                     @id @default(autoincrement())
  code               String                  @unique
  sourceWarehouseId  Int
  sourceWarehouse    Warehouse               @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationType    String                  // TransferDestinationType
  destinationBranchId Int?
  destinationBranch  Branch?                 @relation("DestinationBranch", fields: [destinationBranchId], references: [id])
  thirdPartyId       Int?
  thirdParty         ThirdParty?             @relation(fields: [thirdPartyId], references: [id])
  status             String                  @default("PENDIENTE") // TransferStatus
  notes              String?
  createdById        Int
  createdBy          User                    @relation("CreatedBy", fields: [createdById], references: [id])
  receivedById       Int?
  receivedBy         User?                   @relation("ReceivedBy", fields: [receivedById], references: [id])
  sentAt             DateTime?
  receivedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime                @default(now())

  items TransferItem[]

  @@index([status])
}

model TransferItem {
  id               Int            @id @default(autoincrement())
  transferId       Int
  transfer         Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId        Int
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  quantity         Int // enviada
  receivedQuantity Int? // recibida (confirmación)
  damagedQuantity  Int? @default(0) // dañado en tránsito
}

// ---------- Clientes y ventas ----------
model Client {
  id        Int      @id @default(autoincrement())
  ci        String   @unique // búsqueda por CI
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales      Sale[]
  quotations Quotation[]
}

model Sale {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  locationType  String     // LocationType: BODEGA = venta desde fábrica
  locationId    Int
  branch        Branch?    @relation(fields: [locationId], references: [id])
  clientId      Int
  client        Client     @relation(fields: [clientId], references: [id])
  sellerId      Int
  seller        User       @relation("Seller", fields: [sellerId], references: [id])
  status        String     @default("ACTIVA") // SaleStatus
  total         Float
  paymentMethod String     @default("EFECTIVO") // EFECTIVO | QR | TARJETA | MIXTO
  amountPaid    Float?     // monto entregado por el cliente
  changeAmount  Float?     // cambio / vuelto devuelto
  notes         String?    // notas o referencia de pago
  paymentType   String     @default("CONTADO") // CONTADO | ANTICIPO
  pendingBalance Float     @default(0)         // saldo pendiente por cobrar
  deliveryStatus String    @default("ENTREGADO") // ENTREGADO | PENDIENTE_ENTREGA
  deliveryDate   DateTime?
  cashShiftId   Int?
  cashShift     CashShift? @relation(fields: [cashShiftId], references: [id])
  canceledById  Int?
  canceledBy    User?      @relation("CanceledBy", fields: [canceledById], references: [id])
  cancelReason  String?
  canceledAt    DateTime?
  createdAt     DateTime   @default(now())

  payments         SalePayment[]
  items            SaleItem[]
  productionOrders ProductionOrder[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([locationId])
  @@index([cashShiftId])
  @@index([deliveryStatus])
}

// ---------- Control de Caja (Arqueo y Cierre) ----------
model CashShift {
  id              Int            @id @default(autoincrement())
  branchId        Int?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  openedById      Int
  openedBy        User           @relation("OpenedBy", fields: [openedById], references: [id])
  closedById      Int?
  closedBy        User?          @relation("ClosedBy", fields: [closedById], references: [id])
  status          String         @default("ABIERTA") // ABIERTA | CERRADA
  initialCash     Float          @default(0) // fondo de caja inicial
  expectedCash    Float?         // efectivo calculado por el sistema
  actualCash      Float?         // efectivo contado por el cajero
  difference      Float?         // descuadre (actualCash - expectedCash)
  notes           String?        // observaciones de cierre
  openedAt        DateTime       @default(now())
  closedAt        DateTime?

  sales           Sale[]
  payments        SalePayment[]
  movements       CashMovement[]

  @@index([status, branchId])
  @@index([openedById])
}

model CashMovement {
  id          Int        @id @default(autoincrement())
  cashShiftId Int
  cashShift   CashShift  @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type        String     // ENTRADA | SALIDA
  amount      Float
  reason      String     // Motivo (ej. compra de suministros, cambio, etc.)
  createdAt   DateTime   @default(now())

  @@index([cashShiftId])
}

model SaleItem {
  id                Int            @id @default(autoincrement())
  saleId            Int
  sale              Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId         Int
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  quantity          Int
  unitPrice         Float
  unitCost          Float          @default(0) // costo unitario al momento de la venta
  warrantySeal      String?        // código/número de sello de garantía entregado
  warrantyExpiresAt DateTime?      // fecha exacta de expiración de la garantía

  @@index([warrantySeal])
}

// ---------- Auditoría y notificaciones ----------
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // CREAR | EDITAR | ANULAR | LOGIN | ...
  module     String // ventas | transferencias | inventario | ...
  entity     String? // nombre de tabla/entidad
  entityId   Int?
  detail     String? // JSON resumen
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([module, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String // STOCK_CRITICO | TRANSFERENCIA_CREADA | TRANSFERENCIA_RECIBIDA | VENTA_ANULADA | USUARIO_BLOQUEADO
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ---------- Órdenes de Fabricación / Pedidos a Medida ----------
model ProductionOrder {
  id            Int             @id @default(autoincrement())
  code          String          @unique // ej. OF-2026-0001
  variantId     Int
  variant       ProductVariant  @relation(fields: [variantId], references: [id])
  quantity      Int             @default(1)
  branchId      Int?            // sucursal solicitante
  branch        Branch?         @relation(fields: [branchId], references: [id])
  warehouseId   Int?            // bodega / fábrica productora
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id])
  requestedById Int
  requestedBy   User            @relation("RequestedProduction", fields: [requestedById], references: [id])
  assignedToId  Int?            // operario o encargado asignado
  assignedTo    User?           @relation("AssignedProduction", fields: [assignedToId], references: [id])
  status        String          @default("PENDIENTE") // PENDIENTE | EN_PROCESO | TERMINADO | CANCELADO
  priority      String          @default("NORMAL")    // BAJA | NORMAL | ALTA | URGENTE
  customNotes   String?         // especificaciones (medidas, tela, firmeza)
  saleId        Int?            // si está vinculado a una venta con anticipo
  sale          Sale?           @relation(fields: [saleId], references: [id])
  targetDate    DateTime?       // fecha estimada de entrega
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([branchId])
}

// ---------- Cotizaciones y Proformas ----------
model Quotation {
  id          Int             @id @default(autoincrement())
  code        String          @unique // ej. COT-2026-0001
  clientId    Int?
  client      Client?         @relation(fields: [clientId], references: [id])
  clientName  String          // Nombre cliente o empresa (ej. Hotel Radisson, Juan Perez)
  clientCi    String?         // CI o NIT
  clientPhone String?
  clientEmail String?
  total       Float
  validDays   Int             @default(15) // validez de la oferta en días
  status      String          @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA | CONVERTIDA_A_VENTA
  notes       String?         // condiciones comerciales, tiempo de entrega, etc.
  createdById Int
  createdBy   User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       QuotationItem[]

  @@index([status])
  @@index([clientId])
}

model QuotationItem {
  id          Int            @id @default(autoincrement())
  quotationId Int
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variantId   Int
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Float
  subtotal    Float

  @@index([quotationId])
}


// Cobros aplicados: cada importe conserva su medio y turno, sin duplicar caja chica.
model SalePayment {
  id            Int @id @default(autoincrement())
  saleId        Int
  sale          Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashShiftId   Int?
  cashShift     CashShift? @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  userId        Int
  kind          String @default("INITIAL")
  paymentMethod String
  amount        Float
  createdAt     DateTime @default(now())
  @@index([saleId])
  @@index([cashShiftId])
}
