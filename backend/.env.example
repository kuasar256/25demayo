# Configuración local: copiar este archivo a .env y completar los valores
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/colchones_db?schema=public"
# Generar una clave aleatoria privada de al menos 32 caracteres; no usar esta cadena en producción
JWT_SECRET=""
JWT_EXPIRES_IN="12h"
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Opcional: dejar vacío si no se utiliza acceso con Google
GOOGLE_CLIENT_ID=""
